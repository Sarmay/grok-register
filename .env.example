# 本地构建时保持下面默认值；使用 GHCR 时改为 ghcr.io/kaibush/grok-register:latest
GROK_REGISTER_IMAGE=grok-register:local
GROK_WEB_PORT=8787
GROK_WEB_COOKIE_SECURE=0
GROK_SHM_SIZE=1gb
XVFB_SCREEN=1920x1080x24
TZ=Asia/Shanghai

# 浏览器后端：camoufox（默认，始终保留）或 cloakbrowser
GROK_BROWSER_ENGINE=camoufox
# CloakBrowser 可选配置；留空时使用其本地可用版本与默认通道。
CLOAKBROWSER_LICENSE_KEY=
CLOAKBROWSER_VERSION=
CLOAKBROWSER_RELEASE_CHANNEL=stable
CLOAKBROWSER_AUTO_UPDATE=false

# 可选 GrokIQ 联动；仅作为 config.json 尚未填写对应字段时的初始默认值。
GROKIQ_WEBHOOK_ENABLED=false
GROKIQ_WEBHOOK_URL=http://grokiq-backend:8090/api/integrations/grok-register/account-imported
GROKIQ_WEBHOOK_TOKEN=
GROKIQ_WEBHOOK_TIMEOUT_SECONDS=10

# compose.grokiq.yaml 使用的 GrokIQ 镜像与启动参数
GROKIQ_BACKEND_IMAGE=ghcr.io/kaibush/grok-iq-backend:latest
GROKIQ_FRONTEND_IMAGE=ghcr.io/kaibush/grok-iq-frontend:latest
GROKIQ_WEB_BIND=0.0.0.0
GROKIQ_WEB_PORT=8091
GROKIQ_GROK2API_BASE_URL=http://host.docker.internal:8000
GROKIQ_GROK2API_ADMIN_USERNAME=
GROKIQ_GROK2API_ADMIN_PASSWORD=
# 聊天广场默认网关的 grok2api 客户端 API Key。留空则使用提供商里单独保存的 Key。
GROKIQ_GROK2API_CLIENT_API_KEY=
GROKIQ_INITIAL_PROBE_ON_REGISTER=true
GROKIQ_REGISTER_PROBE_STABILIZATION_SECONDS=15
GROKIQ_REGISTER_PROBE_PROFILE_IDS=["quality-marker"]
GROKIQ_REGISTER_PROBE_EXECUTION_MODE=chat
GROKIQ_REGISTER_PROBE_ROUNDS=3
GROKIQ_REGISTER_PROBE_PROXY_TARGETS=[{"kind":"direct","id":null}]
GROKIQ_CORS_ORIGINS=https://monitor.lvyrix.com,http://localhost:8091,http://127.0.0.1:8091

# 可选 OutlookEmail 邮箱池（docker compose --profile outlookemail up -d）
OUTLOOKEMAIL_IMAGE=ghcr.io/assast/outlookemail:latest
OUTLOOKEMAIL_PORT=5000
OUTLOOKEMAIL_LOGIN_PASSWORD=change-this-outlookemail-password
# 部署前请替换为随机长字符串：python3 -c 'import secrets; print(secrets.token_hex(32))'
OUTLOOKEMAIL_SECRET_KEY=change-this-outlookemail-secret-key
OUTLOOKEMAIL_DOCKER_UPDATE_ENABLED=true
# 特殊 Docker daemon/socket 代理环境可调整，例如 1.52
OUTLOOKEMAIL_DOCKER_UPDATE_API_VERSION=1.41
# 使用自有 Azure 应用时替换下面两个值
OUTLOOKEMAIL_OAUTH_CLIENT_ID=9e5f94bc-e8a4-4e73-b8be-63364c29d753
OUTLOOKEMAIL_OAUTH_REDIRECT_URI=http://localhost:8080
